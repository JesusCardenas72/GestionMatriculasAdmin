{
  "appId": "com.gestionmatriculas.admin",
  "productName": "Gestion Matriculas Admin",
  "publish": [
    {
      "provider": "generic",
      "url": "https://jesuscardenas72.github.io/GestionMatriculasAdmin/"
    }
  ],
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "PergaminoIcon.ico",
    "node_modules/pdf-to-printer/**/*"
  ],
  "extraResources": [
    {
      "from": "SolicitudCambioGrupo.pdf",
      "to": "SolicitudCambioGrupo.pdf"
    }
  ],
  "asarUnpack": [
    "node_modules/pdf-to-printer/**/*"
  ],
  "win": {
    "target": [
      "nsis",
      "portable",
      "dir"
    ],
    "icon": "PergaminoIcon256.ico"
  },
  "portable": {
    "artifactName": "GestionMatriculas-v${version}-Portable.exe"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "artifactName": "GestionMatriculas-v${version}-Instalador.exe",
    "shortcutName": "Gestión Matrículas",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false
  }
}
